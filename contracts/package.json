{
  "name": "tracedocs-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts: TypeScript types, JSON Schemas, pydantic mirror",
  "scripts": {
    "gen": "node scripts/gen-schemas.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:py": "python3 test_analyze_models.py",
    "test": "npm run typecheck && npm run check:schemas && npm run check:py && npm run validate",
    "validate": "tsx validate.ts",
    "lint:openapi": "redocly lint openapi.yaml",
    "fixtures": "python3 fixtures/generate.py"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.22",
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ts-json-schema-generator": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
