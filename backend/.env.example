NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Shared with the Python analysis service (it reads originals from here)
DATA_DIR=./data
MAX_UPLOAD_BYTES=26214400
PIPELINE_VERSION=0.1.0
# engine: the real reasoning engine. stub: recorded contracts/fixtures/<case>.reasoning.json (mock analysis only)
REASONING_MODE=engine
# mock: answers from contracts/fixtures by matching the uploaded file's SHA-256.
# http: the real Python service. It must share DATA_DIR with this backend (see docs/ANALYSIS_INTEGRATION.md).
ANALYSIS_MODE=mock
ANALYSIS_URL=http://127.0.0.1:8000
ANALYSIS_TIMEOUT_MS=110000
ANALYSIS_RETRY_DELAY_MS=500
CONTRACTS_DIR=../contracts
FIXTURES_DIR=../contracts/fixtures
JOB_TIMEOUT_MS=120000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=1000
WORKER_POLL_MS=500
# Single analyst account. Generate the hash with: npm run hash-password -- "your password"
ANALYST_ID=analyst
ANALYST_DISPLAY_NAME=Analyst
ANALYST_PASSWORD_HASH=
SESSION_TTL_HOURS=8
# Defaults to true in production, false otherwise
# COOKIE_SECURE=false
# Retention period reported by /compliance/retention-policy. Reporting only: nothing is purged automatically.
RETENTION_DAYS=90
